    {
      "name": "Реєстрація користувача з типовим inactive",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/users",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Навчальний користувач inactive\",\n  \"email\": \"{{inactive_email}}\",\n  \"login\": \"{{inactive_login}}\",\n  \"password\": \"{{test_password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', function () { pm.response.to.have.status(201); });",
              "pm.test('Відповідь містить лише публічні поля', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(Object.keys(body).sort()).to.eql(['email', 'id', 'login', 'name', 'status_id'].sort());",
              "  pm.expect(body.id).to.be.a('number');",
              "});",
              "pm.test('Типовий статус — inactive', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(body.status_id).to.eql(0);",
              "  pm.collectionVariables.set('inactive_user_id', String(body.id));",
              "});"
            ]
          }
        }
      ]
    },
