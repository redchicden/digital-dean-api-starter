    "description": "Послідовні локальні перевірки реєстрації, входу, блокування та видалення синтетичних користувачів у практичній роботі №5.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.info.requestName === \"Перевірка доступності /health\") {",
          "  const token = Date.now().toString(36) + Math.random().toString(36).slice(2, 8);",
          "  pm.collectionVariables.set('run_token', token);",
          "  pm.collectionVariables.set('inactive_login', 'p05i' + token);",
          "  pm.collectionVariables.set('active_login', 'p05a' + token);",
          "  pm.collectionVariables.set('unknown_login', 'p05u' + token);",
          "  pm.collectionVariables.set('duplicate_login_email', 'dup-login.' + token + '@example.com');",
          "  pm.collectionVariables.set('duplicate_email_login', 'p05e' + token);",
          "  pm.collectionVariables.set('extra_field_login', 'p05x' + token);",
          "  pm.collectionVariables.set('extra_field_email', 'p05x.' + token + '@example.com');",
          "  pm.collectionVariables.set('invalid_status_login', 'p05s' + token);",
          "  pm.collectionVariables.set('invalid_status_email', 'p05s.' + token + '@example.com');",
          "  pm.collectionVariables.set('inactive_email', 'p05i.' + token + '@example.com');",
          "  pm.collectionVariables.set('active_email', 'p05a.' + token + '@example.com');",
          "  pm.collectionVariables.unset('inactive_user_id');",
          "  pm.collectionVariables.unset('active_user_id');",
          "}"
        ]
      }
    }
  ],
