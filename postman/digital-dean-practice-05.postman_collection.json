          "mode": "raw",
          "raw": "{\n  \"name\": \"Некоректна реєстрація extra\",\n  \"email\": \"{{extra_field_email}}\",\n  \"login\": \"{{extra_field_login}}\",\n  \"password\": \"{{test_password}}\",\n  \"unexpected_field\": \"synthetic-extra\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 422', function () { pm.response.to.have.status(422); });",
              "pm.test('Помилка не розкриває конфіденційні дані', function () {",
              "  const text = pm.response.text();",
              "  const lower = text.toLowerCase();",
              "  pm.expect(text).not.to.include(pm.collectionVariables.get('test_password'));",
              "  pm.expect(lower).not.to.include('\"input\":');",
              "  pm.expect(lower).not.to.include('\"ctx\":');",
              "  pm.expect(lower).not.to.include('sql');",
              "  pm.expect(lower).not.to.include('digital-dean.sqlite');",
              "  const detail = pm.response.json().detail || [];",
              "  detail.forEach(function (entry) {",
              "    pm.expect(entry).not.to.have.property('input');",
              "    pm.expect(entry).not.to.have.property('ctx');",
              "  });",
              "});"
            ]
          }
        }
      ]
    },
